# Public URL of the live site. Drives canonical URLs, the sitemap and RSS.
NEXT_PUBLIC_SITE_URL=https://pinsandneedlescomedy.com

# Password for /admin. Defaults to "weed" if unset.
ADMIN_PASSWORD=weed

# Random string used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET=

# Storage driver: "fs" (default, writes ./data and ./public/uploads)
# or "blob" (Vercel Blob). Leave unset — it picks "blob" automatically
# whenever BLOB_READ_WRITE_TOKEN is present.
# CONTENT_DRIVER=fs

# Set automatically by Vercel when you add a Blob store to the project.
# BLOB_READ_WRITE_TOKEN=
