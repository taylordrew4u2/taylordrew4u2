# Public URL of the live site. Drives canonical URLs, the sitemap and RSS.
NEXT_PUBLIC_SITE_URL=https://pinsandneedlescomedy.com

# Password for /admin. Defaults to "weed" if unset.
ADMIN_PASSWORD=weed

# Random string used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
ADMIN_SECRET=

# Storage driver: "fs" (default, writes ./data and ./public/uploads),
# "github", or "blob". Leave unset — it picks "github" when the two
# CONTENT_GITHUB_* values below are set, else "blob" when
# BLOB_READ_WRITE_TOKEN is present, else "fs".
# CONTENT_DRIVER=fs

# --- Option A: GitHub as the content store (free, no card needed) ---
# Keeps content.json and every upload in a small GitHub repo. Two rules:
#   * Use a DIFFERENT repo from the one this site deploys from, or every
#     autosave would trigger a new deployment.
#   * Keep that repo PRIVATE — content.json holds the Instagram token.
#     Uploads are served through this site's /api/media route, so a private
#     repo still works.
# The token is a fine-grained personal access token (github.com/settings/
# tokens?type=beta) scoped to that one repo with Contents: Read and write.
# CONTENT_GITHUB_TOKEN=
# CONTENT_GITHUB_REPO=your-username/your-content-repo
# CONTENT_GITHUB_BRANCH=main
# Only for GitHub Enterprise; leave unset for github.com.
# CONTENT_GITHUB_API=

# --- Option B: Vercel Blob ---
# Set automatically by Vercel when you add a Blob store to the project.
# BLOB_READ_WRITE_TOKEN=

# Powers the "Log in with Instagram" button under Admin -> Reels -> Instagram
# sync. Create a free app at developers.facebook.com, add the Instagram
# product, and set its OAuth redirect URI to:
#   <NEXT_PUBLIC_SITE_URL above>/api/admin/instagram/callback
# Then copy the app's own ID and secret here. Not required for the rest of
# the site to work -- only for pulling reels in automatically.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
